# Fluent X - AI Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# AI Provider: currently not configured.
# Supported values (future): openai, anthropic, google, custom
AI_PROVIDER=

# API key for the selected provider
AI_API_KEY=

# Model name (provider-specific)
# Examples: gpt-4o, claude-sonnet-4-20250514, gemini-2.0-flash
AI_MODEL=

# Optional: API base URL for custom/self-hosted providers
# AI_API_BASE=
