VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Never add SUPABASE_SERVICE_ROLE_KEY here — it bypasses RLS and must stay server-only (Edge Functions auto-inject it)

# Manual MoMo (Stage 7) — placeholder, configure with real Cartiva MoMo details before production
VITE_MOMO_NETWORK=
VITE_MOMO_ACCOUNT_NAME=
VITE_MOMO_NUMBER=

# Paystack public key (publishable — safe for the browser bundle)
VITE_PAYSTACK_PUBLIC_KEY=
# NEVER put the Paystack SECRET key (sk_...) in this file or any VITE_ variable.
# The secret lives only in Supabase Edge Functions secrets as PAYSTACK_SECRET_KEY.

