VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Never add SUPABASE_SERVICE_ROLE_KEY here — it bypasses RLS and must stay server-only (Edge Functions auto-inject it)

# Manual MoMo (Stage 7) — placeholder, configure with real Cartiva MoMo details before production
VITE_MOMO_NETWORK=
VITE_MOMO_ACCOUNT_NAME=
VITE_MOMO_NUMBER=

# Seev Plus — no client-side key needed. Sessions are created server-side
# by supabase/functions/seevplus-init, which reads SEEVPLUS_SECRET_KEY.
# NEVER put any secret key (sk_...) in this file or any VITE_ variable.
# Set SEEVPLUS_SECRET_KEY in Supabase Dashboard → Edge Functions → Secrets
# (use a sandbox key first; production needs an approved organization).

